rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function activeUser() {
      return hasProfile() && profile().activo == true;
    }

    function role() {
      return activeUser() ? profile().rol : '';
    }

    function isAdmin() {
      return activeUser() && role() == 'admin';
    }

    function isCoordinator() {
      return activeUser() && role() == 'coordinadora';
    }

    function isStaff() {
      return activeUser() &&
        role() in ['admin', 'coordinadora', 'cuerpo_tecnico'];
    }

    function canDeleteClubData() {
      return isAdmin() || isCoordinator();
    }

    // Perfil propio: cada usuario puede consultar su perfil.
    // Solo el administrador puede listar, crear, modificar o eliminar perfiles.
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Colecciones utilizadas por ADIUR FEMENINO.
    // La autenticación y el perfil activo son obligatorios.
    // Jugadoras: lectura y envío de respuestas de encuestas.
    // Cuerpo técnico: lectura y edición, sin eliminación.
    // Coordinación y administración: lectura, edición y eliminación.
    match /{coleccion}/{documento} {
      allow read: if activeUser()
        && coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calculadoraADIUR',
          'planificacionADIUR',
          'planificaciones',
          'gimnasioADIUR',
          'informes',
          'informes_partidos',
          'testeos_adiur',
          'tiemposRendimiento',
          'lesiones',
          'encuestas_periodos',
          'encuestas_respuestas'
        ];

      allow create, update: if isStaff()
        && coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calculadoraADIUR',
          'planificacionADIUR',
          'planificaciones',
          'gimnasioADIUR',
          'informes',
          'informes_partidos',
          'testeos_adiur',
          'tiemposRendimiento',
          'lesiones',
          'encuestas_periodos',
          'encuestas_respuestas'
        ];

      allow create: if activeUser()
        && role() == 'jugadora'
        && coleccion == 'encuestas_respuestas';

      allow delete: if canDeleteClubData()
        && coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calculadoraADIUR',
          'planificacionADIUR',
          'planificaciones',
          'gimnasioADIUR',
          'informes',
          'informes_partidos',
          'testeos_adiur',
          'tiemposRendimiento',
          'lesiones',
          'encuestas_periodos',
          'encuestas_respuestas'
        ];
    }
  }
}
