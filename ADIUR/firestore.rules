rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function activeUser() {
      return hasProfile() && profile().activo == true;
    }

    function isAdmin() {
      return activeUser() && profile().rol == 'admin';
    }

    function isCoordinator() {
      return activeUser() && profile().rol == 'coordinadora';
    }

    function isStaff() {
      return activeUser() &&
        profile().rol in ['admin', 'coordinadora', 'cuerpo_tecnico'];
    }

    function canDeleteClubData() {
      return isAdmin() || isCoordinator();
    }

    function categoryOf(data) {
      return data.keys().hasAny(['categoria'])
        ? data.categoria
        : (data.keys().hasAny(['division']) ? data.division : '');
    }

    function hasCategoryPermission(category) {
      return activeUser() &&
        category is string &&
        profile().categorias is list &&
        category in profile().categorias;
    }

    function canReadCategory(data) {
      return hasCategoryPermission(categoryOf(data));
    }

    function canWriteCategory(data) {
      return isStaff() && hasCategoryPermission(categoryOf(data));
    }

    function canDeleteCategory(data) {
      return canDeleteClubData() && hasCategoryPermission(categoryOf(data));
    }

    function periodIsOpen(periodId, category) {
      let periodPath = /databases/$(database)/documents/encuestas_periodos/$(periodId);
      return exists(periodPath) &&
        get(periodPath).data.estado == 'abierta' &&
        get(periodPath).data.categoria == category;
    }

    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Datos que ya están separados por documento y contienen categoria
    // (o division, en el caso de testeos_adiur).
    match /{coleccion}/{documento} {
      allow read: if coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calendarioADIUR',
          'testeos_adiur',
          'informes_partidos',
          'tiemposRendimiento'
        ] &&
        canReadCategory(resource.data);

      allow read: if coleccion in [
          'informes',
          'lesiones'
        ] &&
        isStaff() &&
        canReadCategory(resource.data);

      allow create: if coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calendarioADIUR',
          'testeos_adiur',
          'informes',
          'informes_partidos',
          'tiemposRendimiento',
          'lesiones'
        ] &&
        canWriteCategory(request.resource.data);

      allow update: if coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calendarioADIUR',
          'testeos_adiur',
          'informes',
          'informes_partidos',
          'tiemposRendimiento',
          'lesiones'
        ] &&
        canWriteCategory(resource.data) &&
        canWriteCategory(request.resource.data);

      allow delete: if coleccion in [
          'jugadoras',
          'partidos',
          'asistenciaADIUR',
          'configuracionAsistenciaADIUR',
          'calendarioADIUR',
          'testeos_adiur',
          'informes',
          'informes_partidos',
          'tiemposRendimiento',
          'lesiones'
        ] &&
        canDeleteCategory(resource.data);
    }

    // Planificación: documentos separados por categoría. El documento
    // principal se conserva como respaldo y solo lo puede leer un admin.
    match /planificacionADIUR/{documento} {
      allow get: if documento == 'principal' && isAdmin();
      allow list: if documento != 'principal' &&
        isStaff() &&
        canReadCategory(resource.data);
      allow get: if documento != 'principal' &&
        isStaff() &&
        canReadCategory(resource.data);
      allow create: if documento != 'principal' &&
        canWriteCategory(request.resource.data);
      allow update: if documento != 'principal' &&
        canWriteCategory(resource.data) &&
        canWriteCategory(request.resource.data);
      allow delete: if documento != 'principal' &&
        canDeleteCategory(resource.data);
    }

    // Gimnasio: cada categoría tiene su documento propio. El documento
    // principal queda preservado como respaldo de solo lectura para admins.
    match /gimnasioADIUR/{documento} {
      allow get: if documento == 'principal' && isAdmin();
      allow list: if documento != 'principal' &&
        canReadCategory(resource.data);
      allow get: if documento != 'principal' &&
        canReadCategory(resource.data);
      allow create: if documento != 'principal' &&
        canWriteCategory(request.resource.data);
      allow update: if documento != 'principal' &&
        canWriteCategory(resource.data) &&
        canWriteCategory(request.resource.data);
      allow delete: if documento != 'principal' &&
        canDeleteCategory(resource.data);
    }

    // Calculadora: un documento por división. El documento principal
    // se mantiene intacto como respaldo administrativo.
    match /calculadoraADIUR/{documento} {
      allow get: if documento == 'principal' && isAdmin();
      allow list: if documento != 'principal' &&
        isStaff() &&
        canReadCategory(resource.data);
      allow get: if documento != 'principal' &&
        isStaff() &&
        canReadCategory(resource.data);
      allow create: if documento != 'principal' &&
        canWriteCategory(request.resource.data);
      allow update: if documento != 'principal' &&
        canWriteCategory(resource.data) &&
        canWriteCategory(request.resource.data);
      allow delete: if documento != 'principal' &&
        canDeleteCategory(resource.data);
    }

    // Publicación de encuestas: un enlace público solo puede leer un período
    // abierto por su ID; las consultas normales quedan limitadas por categoría.
    match /encuestas_periodos/{periodoId} {
      allow get: if (activeUser() && canReadCategory(resource.data)) ||
        (!signedIn() && resource.data.estado == 'abierta');
      allow list: if activeUser() && canReadCategory(resource.data);
      allow create: if isStaff() && canWriteCategory(request.resource.data);
      allow update: if isStaff() &&
        canWriteCategory(resource.data) &&
        canWriteCategory(request.resource.data);
      allow delete: if canDeleteCategory(resource.data);
    }

    match /encuestas_respuestas/{respuestaId} {
      allow read: if activeUser() && (
        (isStaff() && canReadCategory(resource.data)) ||
        (profile().rol == 'jugadora' && resource.data.uid == request.auth.uid)
      );

      // Una jugadora autenticada solo puede crear su propia respuesta.
      allow create: if activeUser() &&
        profile().rol == 'jugadora' &&
        request.resource.data.uid == request.auth.uid &&
        hasCategoryPermission(categoryOf(request.resource.data));

      // Los enlaces públicos solo aceptan respuestas para un período abierto.
      allow create: if !signedIn() &&
        request.resource.data.uid == null &&
        periodIsOpen(request.resource.data.periodoId, request.resource.data.categoria);

      allow update: if false;
      allow delete: if canDeleteClubData() &&
        hasCategoryPermission(categoryOf(resource.data));
    }

    // Cada usuario puede leer y guardar únicamente su propia pizarra táctica.
    match /pizarrasADIUR/{uid} {
      allow get: if isStaff() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isStaff() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if isStaff() && request.auth.uid == uid && resource.data.uid == uid && request.resource.data.uid == uid;
      allow delete: if isStaff() && request.auth.uid == uid && resource.data.uid == uid;
    }

    // Documento legado de plantel completo: se conserva, pero no se usa
    // desde las páginas y no queda disponible para cuentas no administradoras.
    match /plantel/{documento} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Denegar cualquier colección o documento que no esté contemplado arriba.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}