rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function activeUser() {
      return hasProfile() && profile().activo == true;
    }

    function role() {
      return activeUser() ? profile().rol : '';
    }

    function isAdmin() {
      return activeUser() && role() == 'admin';
    }

    function isCoordinator() {
      return activeUser() && role() == 'coordinadora';
    }

    function isStaff() {
      return activeUser() &&
        role() in ['admin', 'coordinadora', 'cuerpo_tecnico'];
    }

    function canDeleteClubData() {
      return isAdmin() || isCoordinator();
    }

    function coleccionAdiur(nombre) {
      return nombre in [
        'jugadoras',
        'partidos',
        'asistenciaADIUR',
        'configuracionAsistenciaADIUR',
        'calculadoraADIUR',
        'planificacionADIUR',
        'planificaciones',
        'gimnasioADIUR',
        'informes',
        'informes_partidos',
        'testeos_adiur',
        'tiemposRendimiento',
        'lesiones',
        'encuestas_periodos',
        'encuestas_respuestas'
      ];
    }

    // El usuario consulta su propio perfil. Solo Fran (admin) administra perfiles.
    match /usuarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Datos del club: solo perfiles activos. Jugadoras consultan y responden
    // encuestas; cuerpo técnico edita; coordinación y administración también eliminan.
    match /{coleccion}/{documento} {
      allow read: if activeUser() && coleccionAdiur(coleccion);

      allow create, update: if isStaff() && coleccionAdiur(coleccion);

      allow create: if activeUser()
        && role() == 'jugadora'
        && coleccion == 'encuestas_respuestas';

      allow delete: if canDeleteClubData() && coleccionAdiur(coleccion);
    }
  }
}
